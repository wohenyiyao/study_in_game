# 复制为 .env 放在 backend/ 下（或直接设系统环境变量）
# 代码默认值可本地直接跑；上生产务必全部显式配置

# ---- MySQL ----
LQ_DB_HOST=127.0.0.1
LQ_DB_PORT=3306
LQ_DB_USER=root
LQ_DB_PASS=root
LQ_DB_NAME=learn_quest

# ---- Redis（验证码）----
LQ_REDIS_URL=redis://127.0.0.1:6379/0

# ---- 令牌签名密钥（生产必须设置固定长随机串：python -c "import secrets;print(secrets.token_hex(32))"）----
# 留空则后端每次启动随机生成，重启后所有登录态失效（仅适合本地临时调试）
LQ_SECRET=

# ---- QQ 邮箱 SMTP（授权码不是 QQ 密码；USER/CODE 留空则真实发信不可用）----
LQ_MAIL_HOST=smtp.qq.com
LQ_MAIL_PORT=465
LQ_MAIL_USER=
LQ_MAIL_CODE=
LQ_MAIL_FROM=

# ---- 开发回显验证码：=1 时 send-code 跳过真实 SMTP、直接把验证码返回给前端（本地联调用，生产必须关闭/删除）----
LQ_DEV_ECHO_CODE=0
